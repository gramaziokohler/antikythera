{
    "version": "1.0",
    "id": "reference-agent-demo",
    "name": "Reference Agent Demo",
    "description": "Drives every tool of the reference agent (ADR-0002, issue-td-10) end to end.",
    "tasks": [
        {
            "id": "start",
            "type": "system.start",
            "outputs": [
                {
                    "name": "process_start_time",
                    "type_hint": "timestamp"
                }
            ]
        },
        {
            "id": "assemble",
            "type": "reference.assemble",
            "description": "Plain input, explicit Input[T], required/defaulted Param[T], defaulted Context[T], optional input.",
            "inputs": [
                {
                    "name": "title",
                    "value": "Antikythera"
                },
                {
                    "name": "subtitle",
                    "value": "Reference Agent Demo"
                },
                {
                    "name": "note",
                    "value": "Generated by the reference agent demo blueprint."
                }
            ],
            "params": [
                {
                    "name": "tag",
                    "value": "demo"
                },
                {
                    "name": "repeat",
                    "value": 2
                }
            ],
            "outputs": [
                {
                    "name": "message"
                },
                {
                    "name": "detail"
                }
            ],
            "depends_on": [
                {
                    "id": "start"
                }
            ]
        },
        {
            "id": "wait",
            "type": "reference.wait",
            "description": "ExecutionContext, checked for cancellation between sleep increments.",
            "params": [
                {
                    "name": "seconds",
                    "value": 0.05
                }
            ],
            "outputs": [
                {
                    "name": "cancelled"
                }
            ],
            "depends_on": [
                {
                    "id": "assemble"
                }
            ]
        },
        {
            "id": "passthrough",
            "type": "reference.passthrough",
            "description": "The Task escape hatch, reading assemble's outputs back as inputs.",
            "inputs": [
                {
                    "name": "message"
                },
                {
                    "name": "detail"
                }
            ],
            "outputs": [
                {
                    "name": "message"
                },
                {
                    "name": "detail"
                }
            ],
            "depends_on": [
                {
                    "id": "wait"
                }
            ]
        },
        {
            "id": "end",
            "type": "system.end",
            "outputs": [
                {
                    "name": "process_end_time",
                    "type_hint": "timestamp"
                }
            ],
            "depends_on": [
                {
                    "id": "passthrough"
                }
            ]
        }
    ]
}
