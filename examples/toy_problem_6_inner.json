{
    "version": "1.0",
    "id": "TP6-inner",
    "name": "Toy Problem 6: Inner blueprint",
    "description": "Inner blueprint of Toy Problem 6, run once per model element: shows a notification with the element_id from the expansion context.",
    "tasks": [
        {
            "id": "start",
            "type": "system.start",
            "outputs": [
                {
                    "name": "process_start_time",
                    "type_hint": "timestamp"
                }
            ]
        },
        {
            "id": "A1",
            "type": "user_interaction.notify",
            "description": "Show which element this run is for",
            "depends_on": [
                {
                    "id": "start"
                }
            ],
            "params": [
                {
                    "name": "title",
                    "value": "Element"
                },
                {
                    "name": "message",
                    "value": "Processing element {element_id}"
                }
            ]
        },
        {
            "id": "end",
            "type": "system.end",
            "outputs": [
                {
                    "name": "process_end_time",
                    "type_hint": "timestamp"
                }
            ],
            "depends_on": [
                {
                    "id": "A1"
                }
            ]
        }
    ]
}
