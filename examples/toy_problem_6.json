{
    "version": "1.0",
    "id": "TP6",
    "name": "Toy Problem 6: One task per model element",
    "description": "Dynamic expansion: the basic_sequencer reads the model given by the model_id session parameter and runs the inner blueprint TP6-inner once per element. Upload a compas_model model and toy_problem_6_inner.json first, then start with params {\"model_id\": \"<id>\"}.",
    "tasks": [
        {
            "id": "start",
            "type": "system.start",
            "outputs": [
                {
                    "name": "process_start_time",
                    "type_hint": "timestamp"
                }
            ]
        },
        {
            "id": "X1",
            "type": "system.composite",
            "description": "Run TP6-inner once per element of the model",
            "params": [
                {
                    "name": "blueprint",
                    "value": {
                        "dynamic": {
                            "blueprint_id": "TP6-inner",
                            "sequencer": "basic_sequencer"
                        }
                    }
                }
            ],
            "depends_on": [
                {
                    "id": "start"
                }
            ]
        },
        {
            "id": "end",
            "type": "system.end",
            "outputs": [
                {
                    "name": "process_end_time",
                    "type_hint": "timestamp"
                }
            ],
            "depends_on": [
                {
                    "id": "X1"
                }
            ]
        }
    ]
}
