# Environment for the optional authentication layer (docker-compose.auth.yml).
# Copy to `.env.auth` (git-ignored) and fill in real values, then run:
#   docker compose --env-file .env.auth -f docker-compose.yml -f docker-compose.auth.yml up
#
# See docs/authentication.md for how to obtain each value.

# Public origin where the stack is reachable, INCLUDING scheme, NO trailing
# slash. Must match the TLS terminator / hostname exactly — dex uses it as its
# OIDC issuer and oauth2-proxy uses it for redirect URLs.
#   Production example: https://antikythera.example.ethz.ch
#   Local HTTP test:    http://localhost
AUTH_PUBLIC_URL=https://antikythera.example.ethz.ch

# Set to "false" ONLY for local http:// testing (cookies over plain HTTP).
# Keep "true" in production.
OAUTH2_PROXY_COOKIE_SECURE=true

# Optional cookie domains, comma-separated. Leave empty for a host-only cookie,
# which is the safest default. This is separate from redirect destinations.
AUTH_COOKIE_DOMAINS=
AUTH_REDIRECT_DOMAINS=

# Docker secret file paths. Create these files with restrictive permissions;
# do not place them in source control. The client/provider files must contain
# only the secret with no trailing newline. The cookie file is exactly 32 raw
# bytes. Suggested setup commands are in docs/authentication.md.
OAUTH2_PROXY_CLIENT_SECRET_FILE=./secrets/auth/oauth2-proxy-client-secret
OAUTH2_PROXY_COOKIE_SECRET_FILE=./secrets/auth/oauth2-proxy-cookie-secret
GOOGLE_CLIENT_SECRET_FILE=./secrets/auth/google-client-secret
GITHUB_CLIENT_SECRET_FILE=./secrets/auth/github-client-secret

# Session lifetime. The session is refreshed through oauth2-proxy while active.
OAUTH2_PROXY_COOKIE_EXPIRE=12h
OAUTH2_PROXY_COOKIE_REFRESH=1h
OAUTH2_PROXY_COOKIE_SAMESITE=lax

# The auth profile exposes raw MQTT on loopback by default. Set this to a
# private/VPN interface only after configuring Mosquitto machine credentials.
AUTH_MQTT_BIND_ADDRESS=127.0.0.1

# Access control: allowed email domain(s), comma-separated.
# LEAVE EMPTY for a strict allowlist — then config/auth/allowlist.txt is the ONLY
# authority (a login only succeeds if the email is listed there).
# A domain here is OR-combined with the allowlist file (anyone at that domain OR
# any listed address gets in). NEVER set "*": it matches every domain and thus
# lets ANY authenticated account in, silently bypassing the allowlist.
#   Strict allowlist:   OAUTH2_PROXY_EMAIL_DOMAINS=
#   Whole ETH domain:   OAUTH2_PROXY_EMAIL_DOMAINS=ethz.ch
OAUTH2_PROXY_EMAIL_DOMAINS=

# ---------------------------------------------------------------------------
# Upstream provider OAuth credentials (register apps per docs/authentication.md).
# Google and GitHub are both enabled and therefore both IDs and secret files are
# required. Dex initialization fails early when either is missing.
# ---------------------------------------------------------------------------

# Google — https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: ${AUTH_PUBLIC_URL}/dex/callback
GOOGLE_CLIENT_ID=

# GitHub — https://github.com/settings/developers (OAuth App)
#   Authorization callback URL: ${AUTH_PUBLIC_URL}/dex/callback
GITHUB_CLIENT_ID=
