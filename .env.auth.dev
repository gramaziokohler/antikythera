# DEV-ONLY environment for local auth verification (local login, plain HTTP).
# Safe to commit — contains no real secrets. Do NOT use in production.
AUTH_PUBLIC_URL=http://localhost
OAUTH2_PROXY_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=unused-by-local-login
GITHUB_CLIENT_ID=unused-by-local-login
# The production overlay requires these interpolation variables, but the dev
# override removes all secret mounts and uses committed local-only values.
OAUTH2_PROXY_CLIENT_SECRET_FILE=/dev/null
OAUTH2_PROXY_COOKIE_SECRET_FILE=/dev/null
GOOGLE_CLIENT_SECRET_FILE=/dev/null
GITHUB_CLIENT_SECRET_FILE=/dev/null
# Empty → the allowlist file is the sole authority (strict). Do NOT use "*".
OAUTH2_PROXY_EMAIL_DOMAINS=
